import json
import os
from datetime import datetime, timezone
from urllib.parse import unquote_plus
from zoneinfo import ZoneInfo

import boto3


SNS_TOPIC_ARN = os.environ["SNS_TOPIC_ARN"]
RECORDING_BUCKET = os.environ["RECORDING_BUCKET"]

QUEUE_NAME_FILTER = os.environ.get("QUEUE_NAME_FILTER", "OIEA")
RECORDING_PREFIX = os.environ.get(
    "RECORDING_PREFIX",
    "call-recordings/ivr/"
)
PRESIGNED_URL_EXPIRATION = int(
    os.environ.get("PRESIGNED_URL_EXPIRATION", "604800")
)
TIME_ZONE = os.environ.get("TIME_ZONE", "America/New_York")


s3 = boto3.client("s3")
sns = boto3.client("sns")


def _extract_contact_id_from_transcript_key(key: str) -> str:
    """
    Example:
    2026/08/07/8128b9d8-0374-420b-a7db-f56c051cc501.json
    """
    filename = key.rsplit("/", 1)[-1]

    if filename.lower().endswith(".json"):
        filename = filename[:-5]

    return filename


def _extract_transcript_text(data: dict) -> str:
    try:
        return data["results"]["transcripts"][0]["transcript"]
    except (KeyError, IndexError, TypeError):
        return ""


def _find_recording_key(
    bucket: str,
    contact_id: str,
    transcript_key: str,
) -> str | None:

    # Pull YYYY/MM/DD from transcription key.
    # Example transcript key:
    # 2026/08/07/<contact-id>.json

    key_parts = transcript_key.split("/")

    if len(key_parts) >= 4:
        year = key_parts[0]
        month = key_parts[1]
        day = key_parts[2]

        search_prefix = (
            f"{RECORDING_PREFIX}"
            f"{year}/{month}/{day}/"
            f"{contact_id}"
        )
    else:
        search_prefix = (
            f"{RECORDING_PREFIX}{contact_id}"
        )

    print(
        f"Searching recording bucket with prefix: "
        f"s3://{bucket}/{search_prefix}"
    )

    try:
        response = s3.list_objects_v2(
            Bucket=bucket,
            Prefix=search_prefix,
        )

        matches = []

        for item in response.get("Contents", []):
            key = item.get("Key", "")

            if key.lower().endswith(".wav"):
                matches.append(item)

        if not matches:
            print(
                f"No WAV recording found for contact "
                f"{contact_id}"
            )
            return None

        newest = max(
            matches,
            key=lambda item: item["LastModified"],
        )

        recording_key = newest["Key"]

        print(
            f"Found recording: "
            f"s3://{bucket}/{recording_key}"
        )

        return recording_key

    except Exception as exc:
        print(
            f"Recording lookup failed for "
            f"{contact_id}: {exc}"
        )
        return None


def _generate_presigned_url(
    bucket: str,
    recording_key: str,
) -> str | None:

    try:
        return s3.generate_presigned_url(
            ClientMethod="get_object",
            Params={
                "Bucket": bucket,
                "Key": recording_key,
                "ResponseContentDisposition": (
                    'attachment; '
                    f'filename="OIEA-Voicemail.wav"'
                ),
                "ResponseContentType": "audio/wav",
            },
            ExpiresIn=PRESIGNED_URL_EXPIRATION,
        )

    except Exception as exc:
        print(
            f"Failed generating presigned URL: {exc}"
        )
        return None


def lambda_handler(event, context):

    processed = 0
    published = 0
    skipped = 0
    failed = 0

    for record in event.get("Records", []):
        processed += 1

        if record.get("eventSource") != "aws:s3":
            skipped += 1
            continue

        transcript_bucket = record["s3"]["bucket"]["name"]
        transcript_key = unquote_plus(
            record["s3"]["object"]["key"]
        )

        if not transcript_key.lower().endswith(".json"):
            print(
                f"Skipping non-JSON object: "
                f"s3://{transcript_bucket}/{transcript_key}"
            )
            skipped += 1
            continue

        contact_id = _extract_contact_id_from_transcript_key(
            transcript_key
        )

        print(
            f"Processing transcript for contact: "
            f"{contact_id}"
        )

        try:
            response = s3.get_object(
                Bucket=transcript_bucket,
                Key=transcript_key,
            )

            body = response["Body"].read()
            data = json.loads(
                body.decode("utf-8")
            )

        except Exception as exc:
            print(
                f"Failed reading transcript JSON: {exc}"
            )
            failed += 1
            continue

        transcript = _extract_transcript_text(
            data
        ).strip()

        if not transcript:
            print(
                f"Skipping empty transcript for "
                f"{contact_id}"
            )
            skipped += 1
            continue

        if transcript.lower().startswith(
            "transcription failed"
        ):
            print(
                f"Skipping failed transcription for "
                f"{contact_id}"
            )
            skipped += 1
            continue

        recording_key = _find_recording_key(
            RECORDING_BUCKET,
            contact_id,
            transcript_key,
        )

        if recording_key:
            recording_url = _generate_presigned_url(
                RECORDING_BUCKET,
                recording_key,
            )
        else:
            recording_url = None

        ts_utc = datetime.now(
            timezone.utc
        ).strftime(
            "%Y-%m-%d %H:%M:%S UTC"
        )

        ts_et = datetime.now(
            ZoneInfo(TIME_ZONE)
        ).strftime(
            "%Y-%m-%d %I:%M:%S %p ET"
        )

        if recording_url:
            recording_section = (
                "-------------------------------------------\n"
                " Recording Download\n"
                "-------------------------------------------\n"
                f"{recording_url}\n\n"
                "This secure link expires in 7 days.\n\n"
            )
        else:
            recording_section = (
                "-------------------------------------------\n"
                " Recording Download\n"
                "-------------------------------------------\n"
                "Recording link unavailable.\n\n"
            )

        message = (
            "===========================================\n"
            " OIEA Voicemail Notification\n"
            "===========================================\n\n"
            f"Queue: {QUEUE_NAME_FILTER}\n"
            f"Timestamp: {ts_et} ({ts_utc})\n\n"
            f"{recording_section}"
            "-------------------------------------------\n"
            " Transcript\n"
            "-------------------------------------------\n"
            f"{transcript}\n\n"
            "-------------------------------------------\n"
            " This automated message was generated by the\n"
            " OIEA VMX3 Voicemail Transcription System.\n"
            "-------------------------------------------\n"
        )

        try:
            sns.publish(
                TopicArn=SNS_TOPIC_ARN,
                Subject="New OIEA Voicemail",
                Message=message,
            )

            published += 1

            print(
                f"SNS publish successful for "
                f"{contact_id}"
            )

        except Exception as exc:
            failed += 1

            print(
                f"SNS publish failed for "
                f"{contact_id}: {exc}"
            )

    result = {
        "status": "ok",
        "processed": processed,
        "published": published,
        "skipped": skipped,
        "failed": failed,
    }

    print(json.dumps(result))

    return result

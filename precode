import json
import os
import time
from datetime import datetime, timezone
from urllib.parse import unquote_plus
from zoneinfo import ZoneInfo

import boto3
from botocore.exceptions import ClientError


CONNECT_INSTANCE_ID = os.environ["CONNECT_INSTANCE_ID"]
SNS_TOPIC_ARN = os.environ["SNS_TOPIC_ARN"]
RECORDING_BUCKET = os.environ["RECORDING_BUCKET"]

QUEUE_NAME_FILTER = os.environ.get("QUEUE_NAME_FILTER", "OIEA")
RECORDING_PREFIX = os.environ.get("RECORDING_PREFIX", "")
PRESIGNED_URL_EXPIRATION = int(
    os.environ.get("PRESIGNED_URL_EXPIRATION", "604800")
)
VMX3_PREFIX = os.environ.get("VMX3_PREFIX", "vmx3_")
TIME_ZONE = os.environ.get("TIME_ZONE", "America/New_York")

s3 = boto3.client("s3")
sns = boto3.client("sns")
connect = boto3.client("connect")


RETRY_DELAYS = [2, 4, 8, 12, 15]


def _get_contact_id_from_job_name(job_name: str) -> str:
    if job_name.startswith(VMX3_PREFIX):
        return job_name[len(VMX3_PREFIX):]
    return job_name


def _describe_contact_with_retry(
    instance_id: str,
    contact_id: str,
) -> dict:
    for attempt, delay in enumerate(RETRY_DELAYS, start=1):
        try:
            response = connect.describe_contact(
                InstanceId=instance_id,
                ContactId=contact_id,
            )
            return response.get("Contact", {}) or {}

        except ClientError as exc:
            error_code = exc.response.get(
                "Error", {}
            ).get("Code", "")

            print(
                f"DescribeContact attempt {attempt} "
                f"failed for {contact_id}: "
                f"{error_code} - {exc}"
            )

            if error_code != "ResourceNotFoundException":
                return {}

            if attempt < len(RETRY_DELAYS):
                print(
                    f"Retrying DescribeContact in "
                    f"{delay} seconds..."
                )
                time.sleep(delay)

        except Exception as exc:
            print(
                f"DescribeContact unexpected error "
                f"for {contact_id}: {exc}"
            )
            return {}

    return {}


def _get_queue_name(
    instance_id: str,
    contact: dict,
    contact_id: str,
) -> str | None:
    try:
        queue_id = contact.get(
            "QueueInfo", {}
        ).get("Id")

        if not queue_id:
            return None

        response = connect.describe_queue(
            InstanceId=instance_id,
            QueueId=queue_id,
        )

        return response.get(
            "Queue", {}
        ).get("Name")

    except Exception as exc:
        print(
            f"DescribeQueue error for "
            f"{contact_id}: {exc}"
        )
        return None


def _get_attributes_with_retry(
    instance_id: str,
    contact: dict,
    contact_id: str,
) -> dict:
    initial_contact_id = (
        contact.get("InitialContactId")
        or contact_id
    )

    for attempt, delay in enumerate(
        RETRY_DELAYS,
        start=1,
    ):
        try:
            response = connect.get_contact_attributes(
                InstanceId=instance_id,
                InitialContactId=initial_contact_id,
            )

            return response.get(
                "Attributes", {}
            ) or {}

        except ClientError as exc:
            error_code = exc.response.get(
                "Error", {}
            ).get("Code", "")

            print(
                f"GetContactAttributes attempt "
                f"{attempt} failed for "
                f"{contact_id}: "
                f"{error_code} - {exc}"
            )

            if error_code != "ResourceNotFoundException":
                return {}

            if attempt < len(RETRY_DELAYS):
                print(
                    f"Retrying GetContactAttributes "
                    f"in {delay} seconds..."
                )
                time.sleep(delay)

        except Exception as exc:
            print(
                f"GetContactAttributes unexpected "
                f"error for {contact_id}: {exc}"
            )
            return {}

    return {}


def _extract_transcript_text(data: dict) -> str:
    try:
        return data[
            "results"
        ][
            "transcripts"
        ][0][
            "transcript"
        ]
    except (
        KeyError,
        IndexError,
        TypeError,
    ):
        return ""


def _find_recording_key(
    bucket: str,
    contact_id: str,
) -> str | None:
    paginator = s3.get_paginator(
        "list_objects_v2"
    )

    pagination_config = {
        "Bucket": bucket,
    }

    if RECORDING_PREFIX:
        pagination_config[
            "Prefix"
        ] = RECORDING_PREFIX

    try:
        matching_objects = []

        for page in paginator.paginate(
            **pagination_config
        ):
            for item in page.get(
                "Contents", []
            ):
                key = item.get(
                    "Key", ""
                )

                if (
                    contact_id in key
                    and key.lower().endswith(
                        ".wav"
                    )
                ):
                    matching_objects.append(
                        item
                    )

        if not matching_objects:
            print(
                f"No WAV recording found "
                f"for contact {contact_id}"
            )
            return None

        newest_object = max(
            matching_objects,
            key=lambda item: item[
                "LastModified"
            ],
        )

        recording_key = newest_object[
            "Key"
        ]

        print(
            f"Recording located for "
            f"{contact_id}: "
            f"s3://{bucket}/"
            f"{recording_key}"
        )

        return recording_key

    except Exception as exc:
        print(
            f"Failed searching for "
            f"recording {contact_id}: "
            f"{exc}"
        )
        return None


def _generate_recording_url(
    bucket: str,
    contact_id: str,
) -> str | None:
    recording_key = _find_recording_key(
        bucket=bucket,
        contact_id=contact_id,
    )

    if not recording_key:
        return None

    try:
        return s3.generate_presigned_url(
            ClientMethod="get_object",
            Params={
                "Bucket": bucket,
                "Key": recording_key,
                "ResponseContentDisposition": (
                    "attachment; "
                    f'filename="OIEA-Voicemail-'
                    f'{contact_id}.wav"'
                ),
                "ResponseContentType": (
                    "audio/wav"
                ),
            },
            ExpiresIn=(
                PRESIGNED_URL_EXPIRATION
            ),
        )

    except Exception as exc:
        print(
            f"Failed generating recording "
            f"URL for {contact_id}: "
            f"{exc}"
        )
        return None


def _build_recording_section(
    recording_url: str | None,
) -> str:
    if recording_url:
        return (
            "-------------------------------------------\n"
            " Recording Download\n"
            "-------------------------------------------\n"
            f"{recording_url}\n\n"
            "The recording link expires "
            "in seven days.\n\n"
        )

    return (
        "-------------------------------------------\n"
        " Recording Download\n"
        "-------------------------------------------\n"
        "The recording link could not "
        "be generated.\n\n"
    )


def lambda_handler(event, context):
    processed = 0
    published = 0
    skipped = 0
    failed = 0

    for record in event.get(
        "Records", []
    ):
        processed += 1

        if record.get(
            "eventSource"
        ) != "aws:s3":
            print(
                "Skipping record that "
                "is not from S3"
            )
            skipped += 1
            continue

        bucket = record[
            "s3"
        ][
            "bucket"
        ][
            "name"
        ]

        key = unquote_plus(
            record[
                "s3"
            ][
                "object"
            ][
                "key"
            ]
        )

        if not key.lower().endswith(
            ".json"
        ):
            print(
                f"Skipping non-JSON "
                f"object: "
                f"s3://{bucket}/{key}"
            )
            skipped += 1
            continue

        try:
            response = s3.get_object(
                Bucket=bucket,
                Key=key,
            )

            body = response[
                "Body"
            ].read()

            data = json.loads(
                body.decode("utf-8")
            )

        except Exception as exc:
            print(
                f"Failed to load or parse "
                f"JSON "
                f"s3://{bucket}/{key}: "
                f"{exc}"
            )
            failed += 1
            continue

        job_name = data.get(
            "jobName", ""
        )

        contact_id = (
            _get_contact_id_from_job_name(
                job_name
            )
        )

        if not contact_id:
            print(
                f"No contact ID could "
                f"be resolved from "
                f"jobName '{job_name}'"
            )
            skipped += 1
            continue

        transcript = (
            _extract_transcript_text(
                data
            ).strip()
        )

        if not transcript:
            print(
                f"Skipping empty "
                f"transcript for "
                f"{contact_id}"
            )
            skipped += 1
            continue

        if transcript.lower().startswith(
            "transcription failed"
        ):
            print(
                f"Skipping failed "
                f"transcript for "
                f"{contact_id}"
            )
            skipped += 1
            continue

        contact = (
            _describe_contact_with_retry(
                CONNECT_INSTANCE_ID,
                contact_id,
            )
        )

        queue_name = _get_queue_name(
            CONNECT_INSTANCE_ID,
            contact,
            contact_id,
        )

        attributes = (
            _get_attributes_with_retry(
                CONNECT_INSTANCE_ID,
                contact,
                contact_id,
            )
        )

        if not queue_name:
            queue_name = (
                attributes.get(
                    "QueueName"
                )
            )

        if (
            queue_name
            != QUEUE_NAME_FILTER
        ):
            print(
                f"Skipping non-target "
                f"queue '{queue_name}' "
                f"for contact "
                f"{contact_id}"
            )
            skipped += 1
            continue

        recording_url = (
            _generate_recording_url(
                bucket=RECORDING_BUCKET,
                contact_id=contact_id,
            )
        )

        timestamp_utc = datetime.now(
            timezone.utc
        ).strftime(
            "%Y-%m-%d %H:%M:%S UTC"
        )

        timestamp_local = datetime.now(
            ZoneInfo(TIME_ZONE)
        ).strftime(
            "%Y-%m-%d %I:%M:%S %p ET"
        )

        caller = attributes.get(
            "CallerNumber",
            "Unknown",
        )

        recording_section = (
            _build_recording_section(
                recording_url
            )
        )

        message = (
            "===========================================\n"
            " OIEA Voicemail Notification\n"
            "===========================================\n\n"
            f"Queue: {queue_name}\n"
            f"Caller: {caller}\n"
            f"Timestamp: "
            f"{timestamp_local}  "
            f"({timestamp_utc})\n\n"
            f"{recording_section}"
            "-------------------------------------------\n"
            " Transcript\n"
            "-------------------------------------------\n"
            f"{transcript}\n\n"
            "-------------------------------------------\n"
            " This automated message was "
            "generated by the\n"
            " OIEA VMX3 Voicemail "
            "Transcription System.\n"
            "-------------------------------------------\n"
        )

        try:
            sns.publish(
                TopicArn=SNS_TOPIC_ARN,
                Subject=(
                    "New OIEA Voicemail"
                ),
                Message=message,
            )

            published += 1

            print(
                f"SNS publish successful "
                f"for contact "
                f"{contact_id}"
            )

        except Exception as exc:
            failed += 1

            print(
                f"SNS publish failed "
                f"for contact "
                f"{contact_id}: "
                f"{exc}"
            )

    result = {
        "status": "ok",
        "processed": processed,
        "published": published,
        "skipped": skipped,
        "failed": failed,
    }

    print(
        json.dumps(result)
    )

    return result

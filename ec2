AWSTemplateFormatVersion: 2010-09-09
Description: Creates an EC2 instance 

Metadata:
  'AWS::CloudFormation::Interface':
    ParameterGroups:
      - Label:
          default: Instance Name Parameters (name will be "project-application-purpose")
        Parameters:
          - pProject
          - pApplicationName
          - pPurpose
      - Label:
          default: EC2 Parameters
        Parameters:
          - pOperatingSystem
          - pInstanceType
          - pADGroupName
          - pSubnet
          - pImmutable
      - Label:
          default: Static Paramaters (DO NOT CHANGE)
        Parameters:
          - pKeyName
          - pSsmSupportGroup
          - pSsmAppGroup
          - pSsmLifeCycle
          - pSsmBusiness
          - pSsmTeam
    ParameterLabels:
      pProject:
        default: Project
      pApplicationName:
        default: Application
      pPurpose:
        default: Purpose
      pOperatingSystem:
        default: Operating System
      pInstanceType:
        default: Instance Type (see https://instances.vantage.sh/ for specs)
      pADGroupName:
        default: Group whose members will have access to the server
      pImmutable:
        default: 'Immutable Instance (WARNING: no users can login if enabled!)'
      pSubnet:
        default: Subnet
      pKeyName:
        default: CyberArk Key Pair
      pSsmSupportGroup:
        default: Support Group
      pSsmAppGroup:
        default: Application Group
      pSsmLifeCycle:
        default: Lifecycle
      pSsmBusiness:
        default: Business
      pSsmTeam:
        default: Team


Parameters:
  # Tags for naming objects
  pProject:
    Type: String
    Description: Enter the Project abbreviation, no spaces allowed.
  pApplicationName:
    Type: String
    Description: Enter the application abbreviation, no spaces allowed. If you are not sure then use the value from the project name in GitHub.
  pPurpose:
    Type: String
    Description: Enter the general purpose of the resource, no spaces allowed.
    ConstraintDescription: Must specify value
    AllowedPattern: >-
      (^[a-zA-Z0-9]+$)
  
  # EC2 configuration parameters
  pOperatingSystem:
    Description: Operating System for the EC2 instance
    Type: String
    AllowedValues: 
      - AmazonLinux2023
      - RHEL8
      - RHEL9
      - Windows2022

  pInstanceType:
    Description: Micro instances are too small to run all the security agents that are required at the SEC.
    Type: String
    AllowedValues:
      - t3.medium
      - t3.large
      - t3.xlarge
      - t3.2xlarge
    Default: t3.medium
  
  # This is the AD group that will be provided SSH access
  # For a custom AD group, add to the list of allowed values, as long as the AD group follows the convention
  # ACES-111111111111-rolename
  pADGroupName:
    Description: In DEV chose 'cmn-builder'.  In STG or PRD, chose 'cmn-maintainer'.
    Type: String
    AllowedValues:
      - 'cmn-builder'
      - 'cmn-maintainer'
    Default: 'cmn-builder'

  pImmutable:
    Description: Mark the EC2 instance as immutable (users cannot login to an immutable instance)
    Type: String
    Default: disabled
    AllowedValues:
      - disabled
      - enabled

  pSubnet:
    Description: The subnet to deploy the instance into.  ACES VPCs include 4 subnets by default, each in a different availability zone.  If you're unsure, leave the default value.
    Type: String
    AllowedValues: 
      - VpcSubnet1
      - VpcSubnet2
      - VpcSubnet3
      - VpcSubnet4
    Default: VpcSubnet1
  
  pKeyName:
    Type: String
    Description: The CyberArk Key Pair (required for control by CyberArkprivileged access management)
    AllowedValues:
      - CyberArkAOB
    Default: CyberArkAOB

  # Tagging parameters from Systems Manager
  pSsmSupportGroup:
    Type: AWS::SSM::Parameter::Value<String>
    Description: Support Group conveys email distribution list of the group that is supporting the resource (DO NOT MODIFY)
    Default: /account/config/SupportGroup
    AllowedValues:
      - /account/config/SupportGroup
 
  pSsmAppGroup:
    Type: AWS::SSM::Parameter::Value<String>
    Description: App Group conveys the application group the resource belongs to (DO NOT MODIFY)
    Default: /account/config/AppGroup
    AllowedValues:
      - /account/config/AppGroup
 
  pSsmLifeCycle:
    Type: AWS::SSM::Parameter::Value<String>
    Description: LifeCycle conveys the lifecycle of the resource (DO NOT MODIFY)
    Default: /account/config/LifeCycle
    AllowedValues:
      - /account/config/LifeCycle
 
  pSsmBusiness:
    Type: AWS::SSM::Parameter::Value<String>
    Description: Business conveys the division or office associated with the resource (DO NOT MODIFY)
    Default: /account/config/Business
    AllowedValues:
      - /account/config/Business

  pSsmTeam:
    Type: AWS::SSM::Parameter::Value<String>
    Description: Team conveys the team or branch associated with the resource (DO NOT MODIFY)
    Default: /account/config/Team
    AllowedValues:
      - /account/config/Team


Mappings:
  OsMap:
    AmazonLinux2023:
      AMI: 'ssm:arn:aws:ssm:us-east-1:215643185918:parameter/ccoe-SECBaseline-AL2023-Immutable/AMI'
      PatchGroup: 'pg-os-aml2023'
    RHEL8:
      AMI: 'ssm:arn:aws:ssm:us-east-1:215643185918:parameter/ccoe-SECBaseline-RHEL8-Immutable/AMI'
      PatchGroup: 'pg-os-rhel'
    RHEL9:
      AMI: 'ssm:arn:aws:ssm:us-east-1:215643185918:parameter/ccoe-SECBaseline-RHEL9-Immutable/AMI'
      PatchGroup: 'pg-os-rhel'
    Windows2022:
      AMI: 'ssm:arn:aws:ssm:us-east-1:215643185918:parameter/ccoe-SECBaseline-Win2022-Immutable/AMI'
      PatchGroup: 'pg-os-windows'


Resources:
  rSecurityGroup:
    Type: 'AWS::EC2::SecurityGroup'
    Properties:
      VpcId: !ImportValue VpcId
      GroupDescription: Allow SSH (22) & RDP (3389) out of server
      SecurityGroupIngress:
      # Permit inbound SSH/RDP from private IPs (RFC1918)
      # Common SEC CIDR ranges: https://secoit.sharepoint.com/sites/oit_ccoe/ACES%20Development%20Guides/EC2%20Security%20Groups%20Explained.aspx
        - CidrIp: 172.16.0.0/12
          FromPort: 22
          ToPort: 22
          IpProtocol: tcp
        - CidrIp: 10.0.0.0/8
          FromPort: 22
          ToPort: 22
          IpProtocol: tcp
        - CidrIp: 192.168.0.0/16
          FromPort: 22
          ToPort: 22
          IpProtocol: tcp
        - CidrIp: 172.16.0.0/12
          FromPort: 3389
          ToPort: 3389
          IpProtocol: tcp
        - CidrIp: 10.0.0.0/8
          FromPort: 3389
          ToPort: 3389
          IpProtocol: tcp
        - CidrIp: 192.168.0.0/16
          FromPort: 3389
          ToPort: 3389
          IpProtocol: tcp
      SecurityGroupEgress:
        - CidrIp: 0.0.0.0/0 #OperatingSystem Updates
          FromPort: 443
          ToPort: 443
          IpProtocol: tcp
        - CidrIp: 0.0.0.0/0 #OperatingSystem Updates
          FromPort: 80
          ToPort: 80
          IpProtocol: tcp
      Tags:
        - Key: Name
          Value: !Sub '${pProject}-${pApplicationName}-${pPurpose}'
        - Key: LifeCycle
          Value: !Ref pSsmLifeCycle
        - Key: Business
          Value: !Ref pSsmBusiness
        - Key: SupportGroup
          Value: !Ref pSsmSupportGroup
        - Key: AppGroup
          Value: !Ref pSsmAppGroup
        - Key: ApplicationName
          Value: !Ref pApplicationName
        - Key: Team
          Value: !Ref pSsmTeam
        - Key: CloudFormationStack
          Value: !Ref AWS::StackId

  rEC2:
    Type: 'AWS::EC2::Instance'
    Properties:
      InstanceType: !Ref pInstanceType
      ImageId: !Sub
        - '{{resolve:${image}}}'
        - image:
            !FindInMap [OsMap, !Ref pOperatingSystem, AMI]
      KeyName: !Ref pKeyName
      # Import Value from your Role template
      IamInstanceProfile: !ImportValue QuickStartEC2InstanceProfileName
      # Launch Template is provisioned thru core stackset for all the accounts
      LaunchTemplate:
        LaunchTemplateId: !ImportValue EC2LaunchTemplateID
        Version: !ImportValue EC2LaunchTemplateVersion
      SecurityGroupIds:
        - !ImportValue VpcEndpointSecurityGroup
        - !Ref rSecurityGroup
      SubnetId: 
        Fn::ImportValue:
          !Sub ${pSubnet}
      BlockDeviceMappings:
        - DeviceName: /dev/xvda
          Ebs:
            VolumeSize: 100
      Tags:
        - Key: Name
          Value: !Sub '${pProject}-${pApplicationName}-${pPurpose}'
        - Key: LifeCycle
          Value: !Ref pSsmLifeCycle
        - Key: Business
          Value: !Ref pSsmBusiness
        - Key: Team
          Value: !Ref pSsmTeam
        - Key: SupportGroup
          Value: !Ref pSsmSupportGroup
        - Key: AppGroup
          Value: !Ref pSsmAppGroup
        - Key: ApplicationName
          Value: !Ref pApplicationName
        - Key: Patch Group
          Value: !FindInMap [OsMap, !Ref pOperatingSystem, PatchGroup]
        - Key: adGroupName
          Value: !Sub
            - 'ACES-${AWS::AccountId}-${rolename}'
            - rolename:
                !Ref pADGroupName
        - Key: AdJoin
          Value: 'Yes' 
        - Key: Immutable
          Value: !Ref pImmutable
        - Key: CloudFormationStack
          Value: !Ref AWS::StackId

Outputs:
  oInstancePrivateIP:
    Description: Private IP address of the EC2 instance
    Value: !GetAtt rEC2.PrivateIp
  oInstanceName:
    Description: Name of the EC2 instance in the console
    Value: !Sub '${pProject}-${pApplicationName}-${pPurpose}'
  oInstanceId:
    Description: ID of the EC2 instance
    Value: !Ref rEC2
